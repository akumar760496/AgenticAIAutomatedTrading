# The dependency rule, enforced. See docs/01-architecture.md section 2.
#
# Imports point inward only:
#     interfaces -> adapters -> application -> ports -> domain
#
# If a contract here is inconvenient, the design is wrong, not the contract.
# Adding an ignore_imports entry is an architectural decision: write it in
# docs/state/DEVLOG.md and ask first (see .claude/skills/architecture-guard).

[importlinter]
root_package = trading_desk
include_external_packages = True

[importlinter:contract:layers]
name = Layered architecture, imports point inward
type = layers
layers =
    trading_desk.interfaces
    trading_desk.adapters
    trading_desk.application
    trading_desk.ports
    trading_desk.domain

[importlinter:contract:agents-stay-inside]
name = Agents may import domain and ports only, never an adapter
type = forbidden
source_modules =
    trading_desk.agents
forbidden_modules =
    trading_desk.adapters
    trading_desk.interfaces
    trading_desk.infra

[importlinter:contract:domain-is-pure]
name = Domain does no I/O - no network, DB, LLM, clock or dataframes
type = forbidden
source_modules =
    trading_desk.domain
forbidden_modules =
    requests
    httpx
    aiohttp
    anthropic
    openai
    redis
    sqlalchemy
    asyncpg
    psycopg
    pandas
    polars
    duckdb
    langgraph
    langchain
    apscheduler
    time
allow_indirect_imports = False

# Note: `datetime` is NOT forbidden here. Domain code legitimately uses date and
# datetime as *types* (an option expiry is a date). The real rule is that domain
# never *reads* a clock, and that is enforced two other ways, both stricter than an
# import ban: ruff's DTZ rules, and tests/domain/test_domain_is_pure.py which greps
# every domain module for clock calls. See docs/state/DEVLOG.md 2026-10-15.

[importlinter:contract:ports-are-thin]
name = Ports declare interfaces only - no concrete clients
type = forbidden
source_modules =
    trading_desk.ports
forbidden_modules =
    requests
    httpx
    anthropic
    redis
    sqlalchemy
    pandas
