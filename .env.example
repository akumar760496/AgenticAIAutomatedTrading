# Copy to .env and fill in. NEVER commit .env - it is gitignored, keep it that way.
# Nothing in here should be pasted into a chat window. Anything that has been,
# treat as compromised and rotate.

# --- Dhan (step 1.1 onwards) ------------------------------------------------
# web.dhan.co -> My Profile -> Access DhanHQ APIs
# Use the API key + secret route, not a 24-hour access token: the snapshotter
# runs unattended for months and a daily manual login defeats it.
DHAN_CLIENT_ID=
DHAN_API_KEY=
DHAN_API_SECRET=
DHAN_REDIRECT_URL=http://localhost:8080/dhan/callback
# 24-hour token: web.dhan.co -> My Profile -> Access DhanHQ APIs -> generate.
# Needed to call the API today. The key+secret consent flow needs a browser login,
# so it cannot run on a schedule; PIN+TOTP is the unattended option and is a
# separate decision (it puts your account PIN in this file).
DHAN_ACCESS_TOKEN=

# --- Anthropic (step 3.1) ---------------------------------------------------
ANTHROPIC_API_KEY=
# Hard monthly cap in rupees. Calls are refused past this, not merely alerted on.
LLM_MONTHLY_CAP_INR=2000

# --- Telegram (step 3.5) ----------------------------------------------------
# The entire v1 delivery mechanism. From @BotFather.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Infrastructure (step 0.5) ----------------------------------------------
DATABASE_URL=postgresql://trading_desk:trading_desk@localhost:5432/trading_desk
REDIS_URL=redis://localhost:6379/0

# --- Runtime ----------------------------------------------------------------
# research = v1 briefing only, no order path. Do not change without reading docs/07.
RUN_MODE=research
LOG_LEVEL=INFO
